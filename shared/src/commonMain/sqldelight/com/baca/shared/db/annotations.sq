CREATE TABLE annotations (
    id TEXT NOT NULL PRIMARY KEY,
    book_hash TEXT NOT NULL,
    kind TEXT NOT NULL,
    anchor TEXT NOT NULL,
    text TEXT NOT NULL,
    note TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    device_id TEXT NOT NULL,
    lamport INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

upsertAnnotation:
INSERT OR REPLACE INTO annotations(id, book_hash, kind, anchor, text, note, created_at, device_id, lamport, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAnnotationsByBook:
SELECT * FROM annotations WHERE book_hash = ? AND deleted = 0 ORDER BY created_at;

selectAnnotationsAll:
SELECT * FROM annotations;

deleteAnnotationsAll:
DELETE FROM annotations;
