CREATE TABLE settings_local (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

setLocal:
INSERT OR REPLACE INTO settings_local(key, value) VALUES (?, ?);

getLocal:
SELECT * FROM settings_local WHERE key = ?;

selectLocalByPrefix:
SELECT * FROM settings_local WHERE key LIKE ? || '%';

selectLocalAll:
SELECT * FROM settings_local;

-- everything except the keys that describe this device itself
deleteLocalExcept:
DELETE FROM settings_local WHERE key NOT IN ?;
